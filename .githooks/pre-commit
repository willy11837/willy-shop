#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"

if command -v pwsh >/dev/null 2>&1; then
  powershell_command="pwsh"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell_command="powershell.exe"
else
  echo "ERROR: PowerShell is required to run the Willy Shop pre-commit checks." >&2
  exit 1
fi

"$powershell_command" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass \
  -File "$repo_root/tools/pre-commit.ps1"