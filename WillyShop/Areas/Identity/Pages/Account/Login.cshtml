@page
@model WillyShop.Areas.Identity.Pages.Account.LoginModel
@{
	ViewData["Title"] = "登入";
}

@* 上方切換標籤：Login / Register *@
<ul class="nav nav-tabs mb-3">
	<li class="nav-item">
		@{ var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty; }
		<a class="nav-link @(currentPage.EndsWith("Login") ? "active" : "")" href="@Url.Page("/Account/Login", new { area = "Identity" })">登入</a>
	</li>
	<li class="nav-item">
		<a class="nav-link @(currentPage.EndsWith("Register") ? "active" : "")" href="@Url.Page("/Account/Register", new { area = "Identity" })">註冊</a>
	</li>
</ul>

@* 顯示錯誤訊息與驗證摘要 *@
<div asp-validation-summary="All" class="text-danger"></div>

@if (TempData["StatusMessage"] != null)
{
	<div class="alert alert-info">@TempData["StatusMessage"]</div>
}

<form method="post" novalidate>
	<div class="mb-3">
		<label asp-for="Input.Account" class="form-label">使用者帳號</label>
		<input asp-for="Input.Account" class="form-control" autocomplete="username" />
		<span asp-validation-for="Input.Account" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Input.Password" class="form-label">密碼</label>
		<input asp-for="Input.Password" class="form-control" />
		<span asp-validation-for="Input.Password" class="text-danger"></span>
	</div>
	<div class="mb-3 form-check">
		<input asp-for="Input.RememberMe" class="form-check-input" />
		<label asp-for="Input.RememberMe" class="form-check-label">記住我</label>
	</div>
	<button type="submit" class="btn btn-primary">登入</button>
	<input type="hidden" asp-for="ReturnUrl" />
</form>

<partial name="_ValidationScriptsPartial" />
