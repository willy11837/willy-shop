@using Microsoft.AspNetCore.Identity
@using WillyShop.Models

@* Identity 預設 layout 需要的 _LoginPartial。顯示登入/登出與使用者名稱。*@
@if (User?.Identity?.IsAuthenticated == true)
{
	<form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" method="post" id="logoutForm">
		<span class="navbar-text me-2">@User.Identity.Name</span>
		<button type="submit" class="btn btn-link nav-link">Logout</button>
	</form>
}
else
{
	<a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
	<a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
}
