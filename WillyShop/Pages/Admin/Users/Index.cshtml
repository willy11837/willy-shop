@page
@model WillyShop.Pages.Admin.Users.IndexModel
@{ ViewData["Title"] = "帳號管理"; }
<h1>帳號管理</h1>
@if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="alert alert-info">@Model.StatusMessage</div> }
<form method="get" class="card card-body mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3 align-items-end">
        <div class="col-md-3"><label asp-for="Account" class="form-label">帳號</label><input asp-for="Account" class="form-control" /></div>
        <div class="col-md-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="ModifiedFrom" class="form-label">修改日期起</label><input asp-for="ModifiedFrom" type="date" class="form-control" /></div>
        <div class="col-md-2"><label asp-for="ModifiedTo" class="form-label">修改日期迄</label><input asp-for="ModifiedTo" type="date" class="form-control" /></div>
        <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary">查詢</button><a asp-page="./Index" class="btn btn-outline-secondary">清除</a></div>
    </div>
</form>
<p><a asp-page="./Create" class="btn btn-success">新增帳號</a></p>
<div class="table-responsive">
<table class="table table-striped table-bordered align-middle">
    <thead><tr><th>操作</th><th>帳號</th><th>名稱</th><th>Email</th><th>權限</th><th>新增時間</th><th>最後修改人員</th><th>最後修改時間</th></tr></thead>
    <tbody>
    @foreach (var user in Model.Users)
    {
        <tr>
            <td>
                <a asp-page="./Edit" asp-route-id="@user.Id">修改</a>
                @if (User.IsInRole(SystemRoles.System)) { <text> | </text><a asp-page="./Delete" asp-route-id="@user.Id" class="text-danger">刪除</a> }
            </td>
            <td>@user.Account</td><td>@user.DisplayName</td><td>@user.Email</td><td>@user.Role</td>
            <td>@user.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td><td>@(user.ModifiedBy ?? "-")</td><td>@(user.ModifiedAt?.ToLocalTime().ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
        </tr>
    }
    </tbody>
</table>
</div>
