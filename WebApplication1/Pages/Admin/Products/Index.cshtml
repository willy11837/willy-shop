@page
@model WebApplication1.Pages.Admin.Products.IndexModel
@{
	ViewData["Title"] = "Admin - Products";
}

<h1>管理：商品列表</h1>

<p><a asp-page="./Create" class="btn btn-success">新增商品</a> <a asp-page="/Products/Index" class="btn btn-outline-primary">商品查詢</a></p>

@if (Model.Products.Count == 0)
{
	<p>目前沒有商品。</p>
}
else
{
	<table class="table">
		<thead>
			<tr><th>代碼</th><th>名稱</th><th>庫存</th><th>狀態</th><th>操作</th></tr>
		</thead>
		<tbody>
		@foreach(var p in Model.Products)
		{
			<tr>
				<td>@p.ProductCode</td>
				<td>@p.Name</td>
				<td>@p.StockQuantity</td>
				<td>@p.Status</td>
				<td><a asp-page="./Edit" asp-route-code="@p.ProductCode">修改</a> | <a asp-page="./Delete" asp-route-code="@p.ProductCode" class="text-danger">刪除</a></td>
			</tr>
		}
		</tbody>
	</table>
}
