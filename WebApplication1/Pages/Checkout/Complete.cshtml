@page
@model WebApplication1.Pages.Checkout.CompleteModel
@{
	ViewData["Title"] = "Checkout Complete";
}

<h1>訂單完成</h1>

@if (Model.Order == null)
{
	<p>找不到訂單。</p>
}
else
{
<dl>
		<dt>訂單編號</dt>
		<dd>@Model.Order.Id</dd>
		<dt>總金額</dt>
		<dd>@Model.Order.TotalAmount.ToString("C")</dd>
		<dt>建立時間</dt>
		<dd>@Model.Order.CreatedAt.ToLocalTime()</dd>
	</dl>

<h3>訂單項目</h3>
@if (Model.Items.Count == 0)
{
	<p>無訂單項目。</p>
}
else
{
	<table class="table">
		<thead>
			<tr><th>商品</th><th>單價</th><th>數量</th><th>小計</th></tr>
		</thead>
		<tbody>
		@foreach (var it in Model.Items)
		{
			<tr>
				<td>@it.ProductName (@it.ProductCode)</td>
				<td>@it.UnitPrice.ToString("C")</td>
				<td>@it.Quantity</td>
				<td>@it.Subtotal.ToString("C")</td>
			</tr>
		}
		</tbody>
	</table>
}
	<a asp-page="/Products/Index" class="btn btn-primary">返回商品列表</a>
}

<div class="mt-3">
	<button class="btn btn-secondary" onclick="window.print();">列印此頁</button>
	@if (Model.Order != null)
	{
		<a class="btn btn-outline-secondary" asp-page="./Complete" asp-route-orderId="@Model.Order.Id" asp-route-handler="ExportCsv">匯出 CSV</a>
	}
</div>
