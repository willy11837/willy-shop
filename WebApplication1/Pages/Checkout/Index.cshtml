@page
@model WebApplication1.Pages.Checkout.IndexModel
@{
	ViewData["Title"] = "Checkout";
}

<h1>結帳</h1>

@if (Model.Items.Count == 0)
{
	<p>購物車為空</p>
}
else
{
	<ul>
	@foreach (var item in Model.Items)
	{
		<li>@item.ProductCode x @item.Quantity</li>
	}
	</ul>

	<form method="post" asp-page-handler="Checkout">
		<button type="submit">付款並下單</button>
	</form>
}
