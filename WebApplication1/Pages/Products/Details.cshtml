@page "{code?}"
@model WebApplication1.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "商品詳細資訊";
}

@if (Model.Product == null)
{
    <div class="empty-state my-5"><div class="empty-state-icon">!</div><h1>找不到商品</h1><p>這項商品可能已下架或網址有誤。</p><a asp-page="./Index" class="btn btn-brand">返回商品列表</a></div>
}
else
{
    var imageUrl = string.IsNullOrWhiteSpace(Model.Product.ImagePath)
        ? Url.Content("~/images/product-placeholder.svg")
        : Model.Product.ImagePath.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.Product.ImagePath
            : Url.Content(Model.Product.ImagePath.StartsWith("~") ? Model.Product.ImagePath : Model.Product.ImagePath.StartsWith("/") ? $"~{Model.Product.ImagePath}" : $"~/{Model.Product.ImagePath}");

    <nav class="detail-breadcrumb" aria-label="麵包屑"><a asp-page="./Index">商品選購</a><span>/</span><span>@Model.Product.Name</span></nav>
    <section class="product-detail-card">
        <div class="row g-0">
            <div class="col-lg-6"><div class="detail-image-wrap"><img src="@imageUrl" alt="@Model.Product.Name" class="detail-image" onerror="this.onerror=null;this.src='@Url.Content("~/images/product-placeholder.svg")';" /></div></div>
            <div class="col-lg-6">
                <div class="detail-content">
                    <div class="detail-meta"><span>@(Model.Product.Category ?? "精選商品")</span><span>@Model.Product.ProductCode</span></div>
                    <h1>@Model.Product.Name</h1>
                    <div class="detail-price">NT$ @Model.Product.Price.ToString("N0")</div>
                    <p class="detail-intro">舒適實穿的日常鞋款，適合居家與輕鬆外出穿著。立即選擇數量加入購物車。</p>
                    <div class="detail-facts">
                        <div><span>商品狀態</span><strong>@Model.Product.Status</strong></div>
                        <div><span>目前庫存</span><strong>@Model.Product.StockQuantity 件</strong></div>
                        <div><span>最後更新</span><strong>@(Model.Product.ModifiedAt?.ToLocalTime().ToString("yyyy/MM/dd") ?? "-")</strong></div>
                    </div>
                    <form method="post" asp-page-handler="AddToCart" class="purchase-panel">
                        <input type="hidden" name="code" value="@Model.Product.ProductCode" />
                        <div class="quantity-field"><label for="qty" class="form-label">購買數量</label><input id="qty" name="qty" type="number" value="1" min="1" max="@Math.Max(1, Model.Product.StockQuantity)" class="form-control" /></div>
                        @if (Model.Product.Status == ProductStatus.可銷售 && Model.Product.StockQuantity > 0)
                        {
                            <button type="submit" class="btn btn-brand btn-lg flex-grow-1">加入購物車</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-lg flex-grow-1" disabled>目前無法購買</button>
                        }
                    </form>
                    <a asp-page="/Checkout/Index" class="btn btn-outline-brand w-100 js-checkout-btn" data-href="/Checkout/Index">前往結帳</a>
                    @if (User.IsInRole(SystemRoles.Store) || User.IsInRole(SystemRoles.Admin) || User.IsInRole(SystemRoles.System))
                    {
                        <div class="admin-product-actions"><span>管理功能</span><a asp-page="/Admin/Products/Edit" asp-route-code="@Model.Product.ProductCode">編輯商品</a><a asp-page="/Admin/Products/Delete" asp-route-code="@Model.Product.ProductCode" class="text-danger">刪除商品</a></div>
                    }
                </div>
            </div>
        </div>
    </section>
    <div class="detail-note-grid">
        <div><strong>安心品質</strong><span>嚴選適合日常穿著的舒適鞋款</span></div>
        <div><strong>會員服務</strong><span>登入後保留購物車與訂單資料</span></div>
        <div><strong>快速選購</strong><span>簡潔流程，輕鬆完成商品選購</span></div>
    </div>
}